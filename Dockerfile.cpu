# Kept for your pipeline’s finder logic; identical to Dockerfile.
FROM public.ecr.aws/docker/library/python:3.10-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl ca-certificates \
    libglib2.0-0 libsm6 libxext6 libxrender1 libjpeg62-turbo \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/
RUN python -m pip install --upgrade pip && pip install -r requirements.txt
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu torch torchvision torchaudio || true
RUN pip install "git+https://github.com/Jaluus/MaskTerial.git#egg=maskterial" || true
COPY app.py /app/
ENV PORT=5000 MODEL_PATH=/opt/maskterial/models
EXPOSE 5000
CMD ["gunicorn","-w","2","-b","0.0.0.0:5000","app:app","--timeout","300"]
